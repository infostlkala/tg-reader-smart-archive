# متغیرهای محیطی پروژه — در پنل Railway (Service → Variables)
# یا با Railway CLI: railway variables --set "KEY=VALUE"
# این فایل فقط نمونه است؛ مقادیر واقعی را در پنل وارد کنید (هرگز .env را کامیت نکنید).

# رمز ورود به پنل مدیریت (اجباری — حتماً تغییر دهید)
ADMIN_PASSWORD=Str0ng-Pass-Change-Me

# کلید امضای کوکی‌های Flask (اجباری — رشته تصادفی طولانی)
SECRET_KEY=change-this-to-a-long-random-string-9f8w7e6r5t4y

# مسیر ذخیره‌سازی داده‌ها — روی Railway باید یک Volume بچسبانید (مثلاً mount path: /data)
# و این متغیر را همان مسیر بگذارید؛ بدون Volume داده‌ها با هر Deploy پاک می‌شوند!
DATA_DIR=/data

# ---------- مخصوص روش اول (Telethon) ----------
# از my.telegram.org → API development tools
API_ID=123456
API_HASH=abcd1234efgh5678ijkl
# اختیاری: اگر سشن را محلی ساخته‌اید، رشته StringSession را اینجا بگذارید
# تا از ورود مجدد در پنل بی‌نیاز شوید. خالی بگذارید = ورود از صفحه ادمین
TG_SESSION=

# ---------- رله اختیاری (اگر سرور به تلگرام دسترسی نداشته باشد) ----------
# می‌توانید پروکسی را از پنل مدیریت (کارتی «مسیر اتصال») تنظیم کنید؛
# اگر پنل روی «اتصال مستقیم» باشد، این متغیر محیطی به‌عنوان جایگزین استفاده می‌شود:
#   TG_PROXY=socks5://user:pass@1.2.3.4:1080
#   TG_PROXY=http://user:pass@5.6.7.8:8080
# خالی = بدون پروکسی (اتصال مستقیم — روی Railway معمولاً نیازی نیست)
TG_PROXY=

# ---------- تنظیمات اجرا (اختیاری) ----------
# تعداد worker های gunicorn — برای این اپ 1 کافی است (قفل worker فقط اجازه یک حلقه می‌دهد)
GUNICORN_WORKERS=1
# 1 = حلقه دریافت خودکار فعال | 0 = فقط دریافت دستی از پنل
WORKER_ENABLED=1

# ---------- هوش مصنوعی (اختیاری، API سازگار با OpenAI) ----------
# آدرس پایه بدون /chat/completions، مثال: https://api.example.com/v1
AI_API_BASE_URL=
AI_API_KEY=
AI_MODEL=

# ---------- انتشار به هاست cPanel شما (اتوماسیون محتوا) ----------
# فایل receiver.php را روی cPanel آپلود کنید و این دو مقدار را ست کنید تا انتشار فعال شود:
PUBLISH_ENDPOINT_URL=          # مثل https://example.com/tg-receiver.php
PUBLISH_SECRET=                # رمز مشترک؛ در receiver.php هم باید همان باشد
# اطلاعات FTP هاست برای آپلود رسانه‌ها (از cPanel → FTP Accounts)
FTP_HOST=
FTP_PORT=21
FTP_USER=
FTP_PASS=
FTP_SECURE=0                   # 1 = FTPS
FTP_REMOTE_DIR=public_html/tg-media
MEDIA_PUBLIC_BASE_URL=         # مثل https://example.com/tg-media
# سقف حجم هر فایل رسانه (MB) — فایل بزرگ‌تر دانلود نمی‌شود
MAX_MEDIA_MB=40
